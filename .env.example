# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/   Local: see docker-compose
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
DB_NAME=coursemate

# hash = offline/dev/tests (no download). local = sentence-transformers all-MiniLM-L6-v2 (384 dims)
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=384

# Optional. Without a key, /ask returns the top matching passages instead of an LLM answer.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

CHUNK_WORDS=120
CHUNK_OVERLAP=20
TOP_K=5
